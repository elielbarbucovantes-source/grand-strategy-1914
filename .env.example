# ---------------------------------------------------------------------------
# .env.example — Modèle de variables d'environnement
#
# IMPORTANT :
# - Ce fichier ne contient AUCUNE valeur réelle et aucun secret.
# - Copier vers `.env` uniquement en local : `cp .env.example .env`.
# - `.env` est ignoré par Git. Ne jamais commiter de clé.
# - Aucune technologie n'est choisie à ce jour : les variables ci-dessous sont
#   des EXEMPLES destinés à être validés lors du choix de la pile (ADR).
#   Décommenter uniquement ce qui est réellement utilisé.
# ---------------------------------------------------------------------------

# --- Environnement applicatif ---------------------------------------------
# APP_ENV=development
# APP_DEBUG=true
# LOG_LEVEL=info

# --- Serveur / API (si une API est retenue) -------------------------------
# GAME_SERVER_HOST=127.0.0.1
# GAME_SERVER_PORT=8080
# PUBLIC_BASE_URL=http://localhost:8080

# --- Persistance (fournisseur à décider) ----------------------------------
# DATABASE_URL=
# REDIS_URL=

# --- Fournisseurs de modèles pour les IA (à décider, ADR requis) ----------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# LLM_DEFAULT_MODEL=
# LLM_REQUEST_TIMEOUT_SECONDS=60

# --- Modèles locaux (hypothèse à étudier) ---------------------------------
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=

# --- Limites de coût et de débit ------------------------------------------
# AI_MAX_TOKENS_PER_TURN=
# AI_MAX_COST_PER_GAME_USD=
# AI_MAX_CONCURRENT_REQUESTS=2

# --- Sécurité (à définir) -------------------------------------------------
# SESSION_SECRET=
# AUTH_PROVIDER=

# --- Observabilité (à définir) --------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=
# SENTRY_DSN=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grand-strategy-1914.invalid/schemas/map.schema.json",
  "title": "Grand Strategy-1914 map layer schemas",
  "description": "Structural validation only. Does not define game rules or contain map features.",
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "polygonGeometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "enum": ["Polygon", "MultiPolygon"] },
        "coordinates": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "lineGeometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "enum": ["LineString", "MultiLineString"] },
        "coordinates": { "type": "array", "minItems": 2 }
      },
      "additionalProperties": false
    },
    "pointGeometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "enum": ["Point", "MultiPoint"] },
        "coordinates": { "type": "array", "minItems": 2 }
      },
      "additionalProperties": false
    },
    "regionProperties": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name_key": { "type": "string", "minLength": 1 },
        "initial_sovereign_id": { "$ref": "#/$defs/id" },
        "relief_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["plains", "forests", "mountains", "hills", "marshes"] }
        },
        "importance_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["demographic", "industrial", "strategic"] }
        },
        "island_class": { "enum": ["major", "small_strategic", "simplified"] },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": true
    },
    "siteProperties": {
      "type": "object",
      "required": ["id", "site_type", "region_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "site_type": { "enum": ["capital", "major_port", "industrial_centre", "fortress", "railway_hub"] },
        "region_id": { "$ref": "#/$defs/id" },
        "name_key": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": true
    },
    "networkProperties": {
      "type": "object",
      "required": ["id", "network_type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "network_type": { "enum": ["railway", "road", "river", "bridge", "passage"] },
        "from_region_id": { "$ref": "#/$defs/id" },
        "to_region_id": { "$ref": "#/$defs/id" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": true
    },
    "fortificationProperties": {
      "type": "object",
      "required": ["id", "region_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "region_id": { "$ref": "#/$defs/id" },
        "name_key": { "type": "string", "minLength": 1 },
        "historical_type": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": true
    },
    "maritimeZoneProperties": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name_key": { "type": "string", "minLength": 1 },
        "strait_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": true
    },
    "reliefProperties": {
      "type": "object",
      "required": ["id", "relief_type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "relief_type": { "enum": ["plains", "forests", "mountains", "hills", "marshes", "major_river"] },
        "region_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": true
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "sourceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": { "type": "object" },
        "properties": { "type": "object" }
      },
      "additionalProperties": true
    },
    "featureCollection": {
      "type": "object",
      "required": ["type", "features"],
      "properties": {
        "type": { "const": "FeatureCollection" },
        "features": { "type": "array" }
      },
      "additionalProperties": true
    },
    "landRegionsCollection": {
      "allOf": [
        { "$ref": "#/$defs/featureCollection" },
        { "properties": { "features": { "maxItems": 100, "items": { "$ref": "#/$defs/regionFeature" } } } }
      ]
    },
    "regionFeature": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        { "properties": { "geometry": { "$ref": "#/$defs/polygonGeometry" }, "properties": { "$ref": "#/$defs/regionProperties" } } }
      ]
    },
    "strategicSitesCollection": {
      "allOf": [
        { "$ref": "#/$defs/featureCollection" },
        { "properties": { "features": { "items": { "$ref": "#/$defs/siteFeature" } } } }
      ]
    },
    "siteFeature": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        { "properties": { "geometry": { "$ref": "#/$defs/pointGeometry" }, "properties": { "$ref": "#/$defs/siteProperties" } } }
      ]
    },
    "transportNetworkCollection": {
      "allOf": [
        { "$ref": "#/$defs/featureCollection" },
        { "properties": { "features": { "items": { "$ref": "#/$defs/networkFeature" } } } }
      ]
    },
    "networkFeature": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        { "properties": { "geometry": { "oneOf": [{ "$ref": "#/$defs/lineGeometry" }, { "$ref": "#/$defs/pointGeometry" }] }, "properties": { "$ref": "#/$defs/networkProperties" } } }
      ]
    },
    "fortificationsCollection": {
      "allOf": [
        { "$ref": "#/$defs/featureCollection" },
        { "properties": { "features": { "items": { "$ref": "#/$defs/fortificationFeature" } } } }
      ]
    },
    "fortificationFeature": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        { "properties": { "geometry": { "oneOf": [{ "$ref": "#/$defs/pointGeometry" }, { "$ref": "#/$defs/lineGeometry" }, { "$ref": "#/$defs/polygonGeometry" }] }, "properties": { "$ref": "#/$defs/fortificationProperties" } } }
      ]
    },
    "maritimeZonesCollection": {
      "allOf": [
        { "$ref": "#/$defs/featureCollection" },
        { "properties": { "features": { "items": { "$ref": "#/$defs/maritimeZoneFeature" } } } }
      ]
    },
    "maritimeZoneFeature": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        { "properties": { "geometry": { "$ref": "#/$defs/polygonGeometry" }, "properties": { "$ref": "#/$defs/maritimeZoneProperties" } } }
      ]
    },
    "reliefCollection": {
      "allOf": [
        { "$ref": "#/$defs/featureCollection" },
        { "properties": { "features": { "items": { "$ref": "#/$defs/reliefFeature" } } } }
      ]
    },
    "reliefFeature": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        { "properties": { "geometry": { "oneOf": [{ "$ref": "#/$defs/polygonGeometry" }, { "$ref": "#/$defs/lineGeometry" }] }, "properties": { "$ref": "#/$defs/reliefProperties" } } }
      ]
    }
  }
}

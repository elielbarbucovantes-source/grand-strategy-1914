{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grand-strategy-1914.invalid/schemas/map.schema.json",
  "title": "Grand Strategy-1914 map layer schemas",
  "description": "Structural validation only. Does not define game rules or contain map features. Includes static map data contracts and presentation/runtime overlay shapes; no game rules or map features are defined.",
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "polygonGeometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "lineGeometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "LineString",
            "MultiLineString"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 2
        }
      },
      "additionalProperties": false
    },
    "pointGeometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Point",
            "MultiPoint"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 2
        }
      },
      "additionalProperties": false
    },
    "regionProperties": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name_key": {
          "type": "string",
          "minLength": 1
        },
        "initial_sovereign_id": {
          "$ref": "#/$defs/id"
        },
        "relief_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "plains",
              "forests",
              "mountains",
              "hills",
              "marshes"
            ]
          }
        },
        "importance_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "demographic",
              "industrial",
              "strategic"
            ]
          }
        },
        "island_class": {
          "enum": [
            "major",
            "small_strategic",
            "simplified"
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "regional_rail_level_ref": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRecord"
          }
        }
      },
      "additionalProperties": true
    },
    "siteProperties": {
      "type": "object",
      "required": [
        "id",
        "site_type",
        "region_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "site_type": {
          "enum": [
            "capital",
            "major_port",
            "industrial_centre",
            "fortress",
            "railway_hub"
          ]
        },
        "region_id": {
          "$ref": "#/$defs/id"
        },
        "name_key": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "additionalProperties": true
    },
    "networkProperties": {
      "type": "object",
      "required": [
        "id",
        "network_type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "network_type": {
          "enum": [
            "railway",
            "road",
            "river",
            "bridge",
            "passage"
          ]
        },
        "from_region_id": {
          "$ref": "#/$defs/id"
        },
        "to_region_id": {
          "$ref": "#/$defs/id"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "network_class": {
          "enum": [
            "main",
            "secondary",
            "navigable"
          ]
        },
        "is_navigable": {
          "type": "boolean"
        },
        "is_major_axis": {
          "type": "boolean"
        },
        "from_site_id": {
          "$ref": "#/$defs/id"
        },
        "to_site_id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "fortificationProperties": {
      "type": "object",
      "required": [
        "id",
        "region_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "region_id": {
          "$ref": "#/$defs/id"
        },
        "name_key": {
          "type": "string",
          "minLength": 1
        },
        "historical_type": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "additionalProperties": true
    },
    "maritimeZoneProperties": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name_key": {
          "type": "string",
          "minLength": 1
        },
        "strait_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "adjacent_zone_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "fleet_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": true
    },
    "reliefProperties": {
      "type": "object",
      "required": [
        "id",
        "relief_type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "relief_type": {
          "enum": [
            "plains",
            "forests",
            "mountains",
            "hills",
            "marshes",
            "major_river"
          ]
        },
        "region_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "additionalProperties": true
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "feature": {
      "type": "object",
      "required": [
        "type",
        "geometry",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "geometry": {
          "type": "object"
        },
        "properties": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "featureCollection": {
      "type": "object",
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "landRegionsCollection": {
      "allOf": [
        {
          "$ref": "#/$defs/featureCollection"
        },
        {
          "properties": {
            "features": {
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/regionFeature"
              }
            }
          }
        }
      ]
    },
    "regionFeature": {
      "allOf": [
        {
          "$ref": "#/$defs/feature"
        },
        {
          "properties": {
            "geometry": {
              "$ref": "#/$defs/polygonGeometry"
            },
            "properties": {
              "$ref": "#/$defs/regionProperties"
            }
          }
        }
      ]
    },
    "strategicSitesCollection": {
      "allOf": [
        {
          "$ref": "#/$defs/featureCollection"
        },
        {
          "properties": {
            "features": {
              "items": {
                "$ref": "#/$defs/siteFeature"
              }
            }
          }
        }
      ]
    },
    "siteFeature": {
      "allOf": [
        {
          "$ref": "#/$defs/feature"
        },
        {
          "properties": {
            "geometry": {
              "$ref": "#/$defs/pointGeometry"
            },
            "properties": {
              "$ref": "#/$defs/siteProperties"
            }
          }
        }
      ]
    },
    "transportNetworkCollection": {
      "allOf": [
        {
          "$ref": "#/$defs/featureCollection"
        },
        {
          "properties": {
            "features": {
              "items": {
                "$ref": "#/$defs/networkFeature"
              }
            }
          }
        }
      ]
    },
    "networkFeature": {
      "allOf": [
        {
          "$ref": "#/$defs/feature"
        },
        {
          "properties": {
            "geometry": {
              "oneOf": [
                {
                  "$ref": "#/$defs/lineGeometry"
                },
                {
                  "$ref": "#/$defs/pointGeometry"
                }
              ]
            },
            "properties": {
              "$ref": "#/$defs/networkProperties"
            }
          }
        }
      ]
    },
    "fortificationsCollection": {
      "allOf": [
        {
          "$ref": "#/$defs/featureCollection"
        },
        {
          "properties": {
            "features": {
              "items": {
                "$ref": "#/$defs/fortificationFeature"
              }
            }
          }
        }
      ]
    },
    "fortificationFeature": {
      "allOf": [
        {
          "$ref": "#/$defs/feature"
        },
        {
          "properties": {
            "geometry": {
              "oneOf": [
                {
                  "$ref": "#/$defs/pointGeometry"
                },
                {
                  "$ref": "#/$defs/lineGeometry"
                },
                {
                  "$ref": "#/$defs/polygonGeometry"
                }
              ]
            },
            "properties": {
              "$ref": "#/$defs/fortificationProperties"
            }
          }
        }
      ]
    },
    "maritimeZonesCollection": {
      "allOf": [
        {
          "$ref": "#/$defs/featureCollection"
        },
        {
          "properties": {
            "features": {
              "items": {
                "$ref": "#/$defs/maritimeZoneFeature"
              }
            }
          }
        }
      ]
    },
    "maritimeZoneFeature": {
      "allOf": [
        {
          "$ref": "#/$defs/feature"
        },
        {
          "properties": {
            "geometry": {
              "$ref": "#/$defs/polygonGeometry"
            },
            "properties": {
              "$ref": "#/$defs/maritimeZoneProperties"
            }
          }
        }
      ]
    },
    "reliefCollection": {
      "allOf": [
        {
          "$ref": "#/$defs/featureCollection"
        },
        {
          "properties": {
            "features": {
              "items": {
                "$ref": "#/$defs/reliefFeature"
              }
            }
          }
        }
      ]
    },
    "reliefFeature": {
      "allOf": [
        {
          "$ref": "#/$defs/feature"
        },
        {
          "properties": {
            "geometry": {
              "oneOf": [
                {
                  "$ref": "#/$defs/polygonGeometry"
                },
                {
                  "$ref": "#/$defs/lineGeometry"
                }
              ]
            },
            "properties": {
              "$ref": "#/$defs/reliefProperties"
            }
          }
        }
      ]
    },
    "resourceRecord": {
      "type": "object",
      "required": [
        "resource_code"
      ],
      "properties": {
        "resource_code": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/measuredValue"
        },
        "production": {
          "$ref": "#/$defs/measuredValue"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "additionalProperties": true
    },
    "measuredValue": {
      "type": "object",
      "required": [
        "value",
        "unit_ref"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "countryStyle": {
      "type": "object",
      "required": [
        "country_id",
        "historical_color"
      ],
      "properties": {
        "country_id": {
          "$ref": "#/$defs/id"
        },
        "historical_color": {
          "$ref": "#/$defs/color"
        },
        "user_color_override": {
          "$ref": "#/$defs/color"
        }
      },
      "additionalProperties": false
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "presentationSettings": {
      "type": "object",
      "properties": {
        "visible_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "economy_industry",
              "rail_roads",
              "relief",
              "diplomacy",
              "intelligence",
              "military_infrastructure"
            ]
          }
        },
        "show_names": {
          "type": "boolean"
        },
        "animate_territorial_transfers": {
          "type": "boolean"
        },
        "graphics_quality": {
          "enum": [
            "automatic",
            "manual"
          ]
        },
        "manual_quality_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "movementOrderOverlay": {
      "type": "object",
      "required": [
        "id",
        "observer_id",
        "order_type",
        "status",
        "origin_ref",
        "destination_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "observer_id": {
          "$ref": "#/$defs/id"
        },
        "order_type": {
          "enum": [
            "movement",
            "attack",
            "retreat",
            "reinforcement"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "blocked",
            "completed"
          ]
        },
        "origin_ref": {
          "$ref": "#/$defs/id"
        },
        "destination_ref": {
          "$ref": "#/$defs/id"
        },
        "estimated_duration": {
          "$ref": "#/$defs/measuredValue"
        },
        "distance": {
          "$ref": "#/$defs/measuredValue"
        },
        "difficulty_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "terrain",
              "infrastructure",
              "border",
              "authorization"
            ]
          }
        },
        "visibility_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "intelligenceRecord": {
      "type": "object",
      "required": [
        "observer_id",
        "target_ref",
        "last_updated"
      ],
      "properties": {
        "observer_id": {
          "$ref": "#/$defs/id"
        },
        "target_ref": {
          "$ref": "#/$defs/id"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "precision_ref": {
          "type": "string"
        },
        "visibility_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "unitOverlay": {
      "type": "object",
      "required": [
        "id",
        "unit_kind",
        "location_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "unit_kind": {
          "enum": [
            "land_army",
            "aircraft_moving",
            "aircraft_based",
            "fleet"
          ]
        },
        "location_ref": {
          "$ref": "#/$defs/id"
        },
        "grouping_ref": {
          "type": "string"
        },
        "composition_ref": {
          "type": "string"
        },
        "observer_id": {
          "$ref": "#/$defs/id"
        },
        "last_intel_update": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "battleOverlay": {
      "type": "object",
      "required": [
        "id",
        "battle_kind",
        "location_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "battle_kind": {
          "enum": [
            "land",
            "naval"
          ]
        },
        "location_ref": {
          "$ref": "#/$defs/id"
        },
        "participant_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "intensity_ref": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": true
    },
    "eventOverlay": {
      "type": "object",
      "required": [
        "id",
        "location_ref",
        "journal_entry_id",
        "temporary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "location_ref": {
          "$ref": "#/$defs/id"
        },
        "journal_entry_id": {
          "$ref": "#/$defs/id"
        },
        "temporary": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "maritimeOverlay": {
      "type": "object",
      "required": [
        "id",
        "overlay_kind",
        "location_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "overlay_kind": {
          "enum": [
            "blockade",
            "trade_route",
            "naval_battle",
            "influence",
            "crisis",
            "supply_line",
            "occupation"
          ]
        },
        "location_ref": {
          "$ref": "#/$defs/id"
        },
        "related_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "intensity_ref": {
          "type": "string"
        },
        "journal_entry_id": {
          "$ref": "#/$defs/id"
        },
        "status_ref": {
          "type": "string"
        },
        "observer_id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "renderStyle": {
      "type": "object",
      "properties": {
        "region_border_width_ref": {
          "type": "string"
        },
        "national_border_width_ref": {
          "type": "string"
        },
        "label_policy_ref": {
          "type": "string"
        },
        "zoom_policy_ref": {
          "type": "string"
        },
        "arrow_style_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hatch_style_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "boundaryProperties": {
      "type": "object",
      "required": [
        "id",
        "boundary_kind",
        "region_a_id",
        "region_b_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "boundary_kind": {
          "enum": [
            "regional",
            "national",
            "river_obstacle",
            "mountain_obstacle",
            "strait",
            "passage"
          ]
        },
        "region_a_id": {
          "$ref": "#/$defs/id"
        },
        "region_b_id": {
          "$ref": "#/$defs/id"
        },
        "passage_ref": {
          "$ref": "#/$defs/id"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "additionalProperties": true
    },
    "boundaryFeature": {
      "allOf": [
        {
          "$ref": "#/$defs/feature"
        },
        {
          "properties": {
            "geometry": {
              "$ref": "#/$defs/lineGeometry"
            },
            "properties": {
              "$ref": "#/$defs/boundaryProperties"
            }
          }
        }
      ]
    },
    "boundaryCollection": {
      "allOf": [
        {
          "$ref": "#/$defs/featureCollection"
        },
        {
          "properties": {
            "features": {
              "items": {
                "$ref": "#/$defs/boundaryFeature"
              }
            }
          }
        }
      ]
    }
  }
}
